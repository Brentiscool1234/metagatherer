# ─────────────────────────────────────────────────────────────────────────────
# MetaGatherer — Environment Variables
# Copy this file to `.env` and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Apify fast mode (recommended) ────────────────────────────────────────────
# Set APIFY_API_KEY to skip the local browser for keyword searches.
# Get your key at: console.apify.com → Settings → Integrations → API token
#
# APIFY_ACTOR_ID is the actor that scrapes Facebook Ads Library.
# Default: apidojo/facebook-ads-library-scraper
# Find more actors by searching "facebook ads library" on apify.com/store.
#
# Priority: Apify → browser (if no Apify key, browser is used automatically).

APIFY_API_KEY=your_apify_api_key_here
APIFY_ACTOR_ID=apidojo/facebook-ads-library-scraper

# Optional: custom input template for the actor (JSON string).
# Use {keyword}, {country}, {limit} as placeholders.
# Only needed if your actor uses different field names than the defaults.
# APIFY_INPUT_TEMPLATE={"query":"{keyword}","countryCode":"{country}","maxResults":{limit}}

# ── Facebook Graph API (optional fallback) ────────────────────────────────────
# If set and no Apify key is present, uses the official Meta API instead of browser.
# Get a token at: developers.facebook.com/tools/explorer → ads_read permission.
FB_ACCESS_TOKEN=your_access_token_here

# Optional: Claude API key for AI-powered keyword expansion.
# Get one at https://console.anthropic.com/
# Without this, the tool falls back to frequency-based keyword extraction.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Discord webhook URL for winner notifications.
# Create one at: Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
